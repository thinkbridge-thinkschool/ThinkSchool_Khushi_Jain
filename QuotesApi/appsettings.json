{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] TraceId={TraceId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureMonitor": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClients",
    "AccessTokenMinutes": 15
  },
  "Entra": {
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  }
}
