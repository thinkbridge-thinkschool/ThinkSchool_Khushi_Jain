{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] TraceId={TraceId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureMonitor": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClients",
    "AccessTokenMinutes": 15
  },
  "ServiceBus": {
    "Topic": "quote-events",
    "AuditSubscription": "audit",
    "ModerationSubscription": "moderation",
    "AuditConsumers": 2
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 50,
    "PollInterval": "00:01:00",
    "DrainBudget": "00:00:02"
  },
  "Entra": {
    "TenantId": "b69d82df-4ebe-474d-9ac7-00efbf13427e",
    "ClientId": "508d033c-f321-4ee4-b670-6a54a197e85c",
    "Audience": "api://508d033c-f321-4ee4-b670-6a54a197e85c"
  }
}
