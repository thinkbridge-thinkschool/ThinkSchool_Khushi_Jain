{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "DocBook",
    "Audience": "DocBookClients",
    "AccessTokenMinutes": 15
  },
  "Outbox": {
    "BatchSize": 50,
    "PollInterval": "00:00:10",
    "MaxAttempts": 5
  },
  "Reminders": {
    "LeadTime": "24:00:00",
    "Interval": "01:00:00",
    "PageSize": 50
  }
}
